{
    "framework": null,
    "buildCommand": "npm ci && npm run build",
    "outputDirectory": "public",
    "regions": ["iad1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30
        }
    },
    "rewrites": [{ "source": "/(.*)", "destination": "/api/index.php" }],
    "crons": [{ "path": "/cron/reset-demo", "schedule": "0 7 * * *" }]
}
